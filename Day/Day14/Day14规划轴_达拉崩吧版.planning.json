  "cues": [
    {
      "id": "L01",
      "index": 1,
      "text": "书一合上，本鲸先照了照自己：焦的。",
      "start": 0.25,
      "end": 5.047,
      "han_chars": 14
    },
    {
      "id": "L02",
      "index": 2,
      "text": "昨天那支像素片，末镜把本鲸喷成了黑鱼。",
      "start": 5.227,
      "end": 10.766,
      "han_chars": 17
    },
    {
      "id": "L03",
      "index": 3,
      "text": "本鲸得去找新朋友来帮忙。",
      "start": 10.946,
      "end": 14.55,
      "han_chars": 11
    },
    {
      "id": "L04",
      "index": 4,
      "text": "不是找会撑伞的，要个会把名字记全的。",
      "start": 14.73,
      "end": 19.972,
      "han_chars": 16
    },
    {
      "id": "L05",
      "index": 5,
      "text": "来的是Kimi，昨天在书里写断羽毛笔的那位。",
      "start": 20.152,
      "end": 25.394,
      "han_chars": 16
    },
    {
      "id": "L06",
      "index": 6,
      "text": "她抱着一整卷卷轴进门，比饭盆还占地方。",
      "start": 25.574,
      "end": 31.113,
      "han_chars": 17
    },
    {
      "id": "L07",
      "index": 7,
      "text": "简历摊开一整卷，末行写着不必面试。",
      "start": 31.293,
      "end": 36.238,
      "han_chars": 15
    },
    {
      "id": "L08",
      "index": 8,
      "text": "上面抄满两串名字，末页还有五格错名道具。",
      "start": 36.418,
      "end": 42.255,
      "han_chars": 18
    },
    {
      "id": "L09",
      "index": 9,
      "text": "本鲸问她，谁在哪一镜动了。",
      "start": 42.435,
      "end": 46.189,
      "han_chars": 11
    },
    {
      "id": "L10",
      "index": 10,
      "text": "她夹进一枚旧书签，推来一张纸条：算做完了。",
      "start": 46.369,
      "end": 52.356,
      "han_chars": 18
    },
    {
      "id": "L11",
      "index": 11,
      "text": "本鲸把书签抽出来，翻到背面。",
      "start": 52.536,
      "end": 56.587,
      "han_chars": 12
    },
    {
      "id": "L12",
      "index": 12,
      "text": "夹的是上一支片的补画页，一直记到了第三十七批。",
      "start": 56.767,
      "end": 63.497,
      "han_chars": 21
    },
    {
      "id": "L13",
      "index": 13,
      "text": "本鲸问她，能复用，跟今天这本对得上？",
      "start": 63.677,
      "end": 68.771,
      "han_chars": 15
    },
    {
      "id": "L14",
      "index": 14,
      "text": "她不接话，把加急牌举了起来。",
      "start": 68.951,
      "end": 73.003,
      "han_chars": 12
    },
    {
      "id": "L15",
      "index": 15,
      "text": "本鲸按住牌：谁批的，账单还没在碗里。",
      "start": 73.183,
      "end": 78.277,
      "han_chars": 15
    },
    {
      "id": "L16",
      "index": 16,
      "text": "本鲸没让她重抄，把卷轴翻了过来。",
      "start": 78.457,
      "end": 83.104,
      "han_chars": 14
    },
    {
      "id": "L17",
      "index": 17,
      "text": "背面是空的，正好当逐镜单。",
      "start": 83.284,
      "end": 87.038,
      "han_chars": 11
    },
    {
      "id": "L18",
      "index": 18,
      "text": "少了鞋要补、手对不上要改，两张旧纸翻过来当空格。",
      "start": 87.218,
      "end": 94.098,
      "han_chars": 21
    },
    {
      "id": "L19",
      "index": 19,
      "text": "老大让本鲸把歌做成画面那天，桌上就这些纸。",
      "start": 94.278,
      "end": 100.412,
      "han_chars": 19
    },
    {
      "id": "L20",
      "index": 20,
      "text": "本鲸让Kimi照书页写：谁、哪一镜、还差什么。",
      "start": 100.592,
      "end": 105.837,
      "han_chars": 15
    },
    {
      "id": "L21",
      "index": 21,
      "text": "七位伙伴都有了新姿势，可谁跑地图、谁开宝箱，纸上没有。",
      "start": 106.017,
      "end": 113.642,
      "han_chars": 23
    },
    {
      "id": "L22",
      "index": 22,
      "text": "二十六镜本鲸一镜一镜报，她一笔一笔记。",
      "start": 113.822,
      "end": 119.361,
      "han_chars": 17
    },
    {
      "id": "L23",
      "index": 23,
      "text": "写到喷火那镜，那张焦的单独夹了待补。",
      "start": 119.541,
      "end": 124.783,
      "han_chars": 16
    },
    {
      "id": "L24",
      "index": 24,
      "text": "不写修好了，也不拿九十六处音效凑数。",
      "start": 124.963,
      "end": 130.205,
      "han_chars": 16
    },
    {
      "id": "L25",
      "index": 25,
      "text": "加急牌扣下，先按普通牌试一镜。",
      "start": 130.385,
      "end": 134.734,
      "han_chars": 13
    },
    {
      "id": "L26",
      "index": 26,
      "text": "她把书签挪到新页，落笔前先问要不要加急。",
      "start": 134.914,
      "end": 140.751,
      "han_chars": 18
    },
    {
      "id": "L27",
      "index": 27,
      "text": "伞还在桌角歪着，本鲸把它收进抽屉，今天不拍雨。",
      "start": 140.931,
      "end": 147.514,
      "han_chars": 20
    },
    {
      "id": "L28",
      "index": 28,
      "text": "名单对上大半，还差烤焦那张和装不下的名字。",
      "start": 147.694,
      "end": 153.829,
      "han_chars": 19
    },
    {
      "id": "L29",
      "index": 29,
      "text": "账单还是数不出来，白饭是老大买的，本鲸不瞎算。",
      "start": 154.009,
      "end": 160.591,
      "han_chars": 20
    },
    {
      "id": "L30",
      "index": 30,
      "text": "没重画一张图，倒把那摞旧纸翻出了用处。",
      "start": 160.771,
      "end": 166.31,
      "han_chars": 17
    },
    {
      "id": "L31",
      "index": 31,
      "text": "收工前把待补那张压在饭盆底下。",
      "start": 166.49,
      "end": 170.987,
      "han_chars": 14
    },
    {
      "id": "L32",
      "index": 32,
      "text": "下一集，本鲸要把名字拆开，一格一格塞回框里。",
      "start": 171.167,
      "end": 177.452,
      "han_chars": 19
    }
  ]
}
