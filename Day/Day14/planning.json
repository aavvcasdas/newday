{
  "measured": false,
  "method": "规划：按 Day13 实测语速 3.36 汉字/秒推算，未对齐本集音源",
  "source_file": "Day/Day14/Day14配音台词.txt",
  "source_sha256": "fnv1a:9b17a3a07b90e597",
  "duration_seconds": 168.893,
  "han_chars": 505,
  "rate_han_per_second": 3.36,
  "note": "没有 Day14 音源。此轴只用于预估节奏与分镜时长，禁止用于正式渲染或标记为已对齐。",
  "cues": [
    {
      "id": "L01",
      "index": 1,
      "text": "诶？伞怎么还没撑稳。",
      "start": 0.25,
      "end": 3.433
    },
    {
      "id": "L02",
      "index": 2,
      "text": "本鲸呢，得去找新朋友来帮忙。",
      "start": 3.613,
      "end": 7.485
    },
    {
      "id": "L03",
      "index": 3,
      "text": "不是找会撑伞的哦，本鲸要个会算账的。",
      "start": 7.665,
      "end": 12.727
    },
    {
      "id": "L04",
      "index": 4,
      "text": "名单上写着龙娘。",
      "start": 12.907,
      "end": 15.14
    },
    {
      "id": "L05",
      "index": 5,
      "text": "她手里呀，总拎着两只沙漏。",
      "start": 15.32,
      "end": 18.893
    },
    {
      "id": "L06",
      "index": 6,
      "text": "本鲸偷偷把饭碗端到门口。",
      "start": 19.073,
      "end": 22.497
    },
    {
      "id": "L07",
      "index": 7,
      "text": "先当作面试的诚意。",
      "start": 22.677,
      "end": 25.208
    },
    {
      "id": "L08",
      "index": 8,
      "text": "她翻了翻本鲸那本账本嘛，半天没说话。",
      "start": 25.388,
      "end": 30.45
    },
    {
      "id": "L09",
      "index": 9,
      "text": "上面只有一行字。",
      "start": 30.63,
      "end": 32.863
    },
    {
      "id": "L10",
      "index": 10,
      "text": "写的是没相关经验。",
      "start": 33.043,
      "end": 35.574
    },
    {
      "id": "L11",
      "index": 11,
      "text": "只在第三十七批干过活。",
      "start": 35.754,
      "end": 38.88
    },
    {
      "id": "L12",
      "index": 12,
      "text": "她哼了一声，说这岗位呀，不看经验。",
      "start": 39.06,
      "end": 43.676
    },
    {
      "id": "L13",
      "index": 13,
      "text": "看的是把数字分清楚。",
      "start": 43.856,
      "end": 46.685
    },
    {
      "id": "L14",
      "index": 14,
      "text": "老大让本鲸把歌做成画面那天。",
      "start": 46.865,
      "end": 50.884
    },
    {
      "id": "L15",
      "index": 15,
      "text": "本鲸真的没算过账。",
      "start": 51.064,
      "end": 53.595
    },
    {
      "id": "L16",
      "index": 16,
      "text": "那天少了鞋要补，手对不上要改。",
      "start": 53.775,
      "end": 57.944
    },
    {
      "id": "L17",
      "index": 17,
      "text": "还有一张给本鲸画出了多余的腿。",
      "start": 58.124,
      "end": 62.441
    },
    {
      "id": "L18",
      "index": 18,
      "text": "只能先放一边。",
      "start": 62.621,
      "end": 64.557
    },
    {
      "id": "L19",
      "index": 19,
      "text": "补图和重试一直记到了第三十七批。",
      "start": 64.737,
      "end": 69.351
    },
    {
      "id": "L20",
      "index": 20,
      "text": "生成图和补画加起来是一百八十五张。",
      "start": 69.531,
      "end": 74.443
    },
    {
      "id": "L21",
      "index": 21,
      "text": "七位伙伴都有了新姿势。",
      "start": 74.623,
      "end": 77.749
    },
    {
      "id": "L22",
      "index": 22,
      "text": "可这顿饭多少钱？谁也没告诉本鲸。",
      "start": 77.929,
      "end": 82.395
    },
    {
      "id": "L23",
      "index": 23,
      "text": "龙娘把小的那只沙漏倒过来。",
      "start": 82.575,
      "end": 86.296
    },
    {
      "id": "L24",
      "index": 24,
      "text": "说它管的是几小时里的用量。",
      "start": 86.476,
      "end": 90.197
    },
    {
      "id": "L25",
      "index": 25,
      "text": "大的那只翻得慢，管的是整整一周。",
      "start": 90.377,
      "end": 94.843
    },
    {
      "id": "L26",
      "index": 26,
      "text": "两只都有余量才敢接活。",
      "start": 95.023,
      "end": 98.149
    },
    {
      "id": "L27",
      "index": 27,
      "text": "空一只就得坐着等。",
      "start": 98.329,
      "end": 100.86
    },
    {
      "id": "L28",
      "index": 28,
      "text": "本鲸问她，这沙漏到底值多少钱。",
      "start": 101.04,
      "end": 105.209
    },
    {
      "id": "L29",
      "index": 29,
      "text": "她呀，摇头摇得很干脆。",
      "start": 105.389,
      "end": 108.572
    },
    {
      "id": "L30",
      "index": 30,
      "text": "说翻过去的是额度，不是价目表。",
      "start": 108.752,
      "end": 112.921
    },
    {
      "id": "L31",
      "index": 31,
      "text": "也不是谁把朋友忘了。",
      "start": 113.101,
      "end": 115.93
    },
    {
      "id": "L32",
      "index": 32,
      "text": "本鲸这才想通，饭碗倒是标着价。",
      "start": 116.11,
      "end": 120.279
    },
    {
      "id": "L33",
      "index": 33,
      "text": "工作日上午九点到十二点，饭最贵。",
      "start": 120.459,
      "end": 124.926
    },
    {
      "id": "L34",
      "index": 34,
      "text": "下午两点到六点也一样贵。",
      "start": 125.106,
      "end": 128.53
    },
    {
      "id": "L35",
      "index": 35,
      "text": "中午那两个小时便宜一半。",
      "start": 128.71,
      "end": 132.134
    },
    {
      "id": "L36",
      "index": 36,
      "text": "本鲸不怕等嘛，就挑这时候多干活。",
      "start": 132.314,
      "end": 136.781
    },
    {
      "id": "L37",
      "index": 37,
      "text": "可图片张数再多，也换不出一个价钱。",
      "start": 136.961,
      "end": 141.725
    },
    {
      "id": "L38",
      "index": 38,
      "text": "本鲸没有摸鱼，只是一直在等便宜的时候。",
      "start": 141.905,
      "end": 147.265
    },
    {
      "id": "L39",
      "index": 39,
      "text": "这米饭嘛，是老大买的。",
      "start": 147.445,
      "end": 150.423
    },
    {
      "id": "L40",
      "index": 40,
      "text": "账单也只能由老大给。",
      "start": 150.603,
      "end": 153.432
    },
    {
      "id": "L41",
      "index": 41,
      "text": "本鲸记得清楚的呢，是批次和返工。",
      "start": 153.612,
      "end": 158.079
    },
    {
      "id": "L42",
      "index": 42,
      "text": "还有谁站不稳，这些都记在纸上。",
      "start": 158.259,
      "end": 162.428
    },
    {
      "id": "L43",
      "index": 43,
      "text": "先把伞撑稳。",
      "start": 162.608,
      "end": 164.246
    },
    {
      "id": "L44",
      "index": 44,
      "text": "下一集，本鲸要让她们自己走两步。",
      "start": 164.426,
      "end": 168.893
    }
  ]
}
