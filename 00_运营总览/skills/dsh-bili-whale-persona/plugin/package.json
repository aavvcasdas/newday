{
  "name": "dsh-bili-whale-persona-toggle",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "设置 → 鲸鲸 · 人设：一个开关切换孙吧味档位（中性/轻损/孙吧全损），改写 ~/.bili-ai/persona.md 与 ~/.dsh/bili-whale-persona.json。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "personas/*.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
