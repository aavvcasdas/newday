{
  "measured": true,
  "source_sha256": "1891c4c7f9c08011ad420e85d1a5c08c343256bcd0a0c5044bd13c91d135bd4e",
  "method": "word-span clause",
  "screens": [
    {
      "line": 1,
      "text": "本鲸昨天护了一晚上的饭碗。",
      "start": 0.065,
      "speech_end": 3.03,
      "end": 3.23
    },
    {
      "line": 2,
      "text": "今天一看，",
      "start": 3.595,
      "speech_end": 4.68,
      "end": 4.88
    },
    {
      "line": 2,
      "text": "碗边怎么多了这么多双筷子？",
      "start": 5.19,
      "speech_end": 7.79,
      "end": 7.99
    },
    {
      "line": 3,
      "text": "不是来抢饭的，",
      "start": 8.95,
      "speech_end": 10.26,
      "end": 10.46
    },
    {
      "line": 3,
      "text": "是昨天拍MV的朋友。",
      "start": 10.62,
      "speech_end": 13.08,
      "end": 12.6
    },
    {
      "line": 4,
      "text": "老大让本鲸把歌做成画面。",
      "start": 12.6,
      "speech_end": 15.51,
      "end": 15.71
    },
    {
      "line": 5,
      "text": "本鲸一听，",
      "start": 16.105,
      "speech_end": 17.07,
      "end": 17.27
    },
    {
      "line": 5,
      "text": "简单，",
      "start": 17.94,
      "speech_end": 18.69,
      "end": 18.89
    },
    {
      "line": 5,
      "text": "不就是让大家站在一起。",
      "start": 19.38,
      "speech_end": 22.105,
      "end": 22.305
    },
    {
      "line": 6,
      "text": "结果一放出来，",
      "start": 23.175,
      "speech_end": 24.72,
      "end": 24.92
    },
    {
      "line": 6,
      "text": "好家伙，",
      "start": 24.93,
      "speech_end": 26.067,
      "end": 26.267
    },
    {
      "line": 6,
      "text": "大家站得比本鲸的饭盆还稳。",
      "start": 27.24,
      "speech_end": 30.18,
      "end": 30.38
    },
    {
      "line": 7,
      "text": "得让她们动起来。",
      "start": 30.635,
      "speech_end": 31.805,
      "end": 32.005
    },
    {
      "line": 8,
      "text": "Claude伸手去够拼图，",
      "start": 32.825,
      "speech_end": 34.8,
      "end": 35.0
    },
    {
      "line": 8,
      "text": "龙娘拿起扫帚。",
      "start": 35.1,
      "speech_end": 36.41,
      "end": 36.61
    },
    {
      "line": 9,
      "text": "千问在给花浇水，",
      "start": 37.05,
      "speech_end": 38.7,
      "end": 38.9
    },
    {
      "line": 9,
      "text": "Kimi抬手指星星。",
      "start": 38.94,
      "speech_end": 40.435,
      "end": 40.635
    },
    {
      "line": 10,
      "text": "Gemini拿着线轴迈步，",
      "start": 41.2,
      "speech_end": 43.02,
      "end": 43.2
    },
    {
      "line": 10,
      "text": "智谱拿着怀表。",
      "start": 43.2,
      "speech_end": 44.475,
      "end": 44.675
    },
    {
      "line": 11,
      "text": "豆包负责撑伞，",
      "start": 45.315,
      "speech_end": 46.71,
      "end": 46.91
    },
    {
      "line": 11,
      "text": "本鲸负责淋雨。",
      "start": 46.92,
      "speech_end": 48.355,
      "end": 48.555
    },
    {
      "line": 12,
      "text": "第一版伞差点只顾上豆包。",
      "start": 48.875,
      "speech_end": 51.57,
      "end": 51.77
    },
    {
      "line": 13,
      "text": "本鲸赶紧把伞面拆开，",
      "start": 52.215,
      "speech_end": 54.48,
      "end": 54.68
    },
    {
      "line": 13,
      "text": "重新给两个人安排位置。",
      "start": 54.69,
      "speech_end": 56.705,
      "end": 56.905
    },
    {
      "line": 14,
      "text": "动作图也不是画一张就能用。",
      "start": 57.87,
      "speech_end": 60.045,
      "end": 60.245
    },
    {
      "line": 15,
      "text": "少了鞋要补，",
      "start": 60.815,
      "speech_end": 62.49,
      "end": 62.69
    },
    {
      "line": 15,
      "text": "手对不上要改。",
      "start": 62.79,
      "speech_end": 64.65,
      "end": 64.85
    },
    {
      "line": 16,
      "text": "还有一张给本鲸画出了多余的腿，",
      "start": 65.28,
      "speech_end": 68.34,
      "end": 68.54
    },
    {
      "line": 16,
      "text": "只能先放一边。",
      "start": 68.7,
      "speech_end": 70.08,
      "end": 70.28
    },
    {
      "line": 17,
      "text": "补图、",
      "start": 70.71,
      "speech_end": 71.13,
      "end": 71.22
    },
    {
      "line": 17,
      "text": "重试，",
      "start": 71.22,
      "speech_end": 72.0,
      "end": 72.2
    },
    {
      "line": 17,
      "text": "一直记到了第三十七批。",
      "start": 72.36,
      "speech_end": 74.025,
      "end": 74.225
    },
    {
      "line": 18,
      "text": "生成图和补画加起来有一百八十五张，",
      "start": 74.6,
      "speech_end": 77.79,
      "end": 77.99
    },
    {
      "line": 18,
      "text": "里面还有没用上的。",
      "start": 78.15,
      "speech_end": 79.56,
      "end": 79.76
    },
    {
      "line": 19,
      "text": "七位伙伴都有了新姿势，",
      "start": 80.14,
      "speech_end": 82.17,
      "end": 82.37
    },
    {
      "line": 19,
      "text": "但一张图不等于一个完整动作。",
      "start": 82.62,
      "speech_end": 85.26,
      "end": 85.46
    },
    {
      "line": 20,
      "text": "雨里坐下还会跳，",
      "start": 86.26,
      "speech_end": 87.81,
      "end": 88.01
    },
    {
      "line": 20,
      "text": "游泳也没那么顺。",
      "start": 88.05,
      "speech_end": 89.3,
      "end": 89.5
    },
    {
      "line": 21,
      "text": "最后把镜头和原歌拼起来，",
      "start": 89.8,
      "speech_end": 92.13,
      "end": 92.31
    },
    {
      "line": 21,
      "text": "先出了待审片。",
      "start": 92.31,
      "speech_end": 93.66,
      "end": 93.86
    },
    {
      "line": 22,
      "text": "你问这顿饭吃了多少Token？",
      "start": 94.32,
      "speech_end": 96.525,
      "end": 96.725
    },
    {
      "line": 23,
      "text": "账单没在本鲸碗里，",
      "start": 96.99,
      "speech_end": 98.55,
      "end": 98.75
    },
    {
      "line": 23,
      "text": "暂时数不出来。",
      "start": 98.79,
      "speech_end": 99.9,
      "end": 100.1
    },
    {
      "line": 24,
      "text": "反正白饭是老大买的，",
      "start": 100.38,
      "speech_end": 102.18,
      "end": 102.38
    },
    {
      "line": 24,
      "text": "不能拿图片张数瞎算。",
      "start": 102.45,
      "speech_end": 104.175,
      "end": 104.375
    },
    {
      "line": 25,
      "text": "昨天那碗饭，",
      "start": 104.665,
      "speech_end": 105.84,
      "end": 105.93
    },
    {
      "line": 25,
      "text": "没白吃。",
      "start": 105.93,
      "speech_end": 106.68,
      "end": 106.88
    },
    {
      "line": 26,
      "text": "下次先把伞撑稳，",
      "start": 106.91,
      "speech_end": 108.75,
      "end": 108.95
    },
    {
      "line": 26,
      "text": "再让大家一起走。",
      "start": 108.99,
      "speech_end": 110.515,
      "end": 110.62
    }
  ]
}