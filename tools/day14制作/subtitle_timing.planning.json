{
  "measured": false,
  "method": "planning: punctuation screens, timing estimated not aligned",
  "source_sha256": "fnv1a:9b17a3a07b90e597",
  "screens": [
    {
      "line": 1,
      "text": "诶？",
      "start": 0.25,
      "speech_end": 1.05,
      "end": 1.2
    },
    {
      "line": 1,
      "text": "伞怎么还没撑稳。",
      "start": 1.2,
      "speech_end": 3.283,
      "end": 3.433
    },
    {
      "line": 2,
      "text": "本鲸呢，",
      "start": 3.613,
      "speech_end": 4.506,
      "end": 4.656
    },
    {
      "line": 2,
      "text": "得去找新朋友来帮忙。",
      "start": 4.656,
      "speech_end": 7.335,
      "end": 7.485
    },
    {
      "line": 3,
      "text": "不是找会撑伞的哦，",
      "start": 7.665,
      "speech_end": 10.046,
      "end": 10.196
    },
    {
      "line": 3,
      "text": "本鲸要个会算账的。",
      "start": 10.196,
      "speech_end": 12.577,
      "end": 12.727
    },
    {
      "line": 4,
      "text": "名单上写着龙娘。",
      "start": 12.907,
      "speech_end": 14.99,
      "end": 15.14
    },
    {
      "line": 5,
      "text": "她手里呀，",
      "start": 15.32,
      "speech_end": 16.51,
      "end": 16.66
    },
    {
      "line": 5,
      "text": "总拎着两只沙漏。",
      "start": 16.66,
      "speech_end": 18.743,
      "end": 18.893
    },
    {
      "line": 6,
      "text": "本鲸偷偷把饭碗端到门口。",
      "start": 19.073,
      "speech_end": 22.347,
      "end": 22.497
    },
    {
      "line": 7,
      "text": "先当作面试的诚意。",
      "start": 22.677,
      "speech_end": 25.058,
      "end": 25.208
    },
    {
      "line": 8,
      "text": "她翻了翻本鲸那本账本嘛，",
      "start": 25.388,
      "speech_end": 28.662,
      "end": 28.812
    },
    {
      "line": 8,
      "text": "半天没说话。",
      "start": 28.812,
      "speech_end": 30.3,
      "end": 30.45
    },
    {
      "line": 9,
      "text": "上面只有一行字。",
      "start": 30.63,
      "speech_end": 32.713,
      "end": 32.863
    },
    {
      "line": 10,
      "text": "写的是没相关经验。",
      "start": 33.043,
      "speech_end": 35.424,
      "end": 35.574
    },
    {
      "line": 11,
      "text": "只在第三十七批干过活。",
      "start": 35.754,
      "speech_end": 38.73,
      "end": 38.88
    },
    {
      "line": 12,
      "text": "她哼了一声，",
      "start": 39.06,
      "speech_end": 40.548,
      "end": 40.698
    },
    {
      "line": 12,
      "text": "说这岗位呀，",
      "start": 40.698,
      "speech_end": 42.186,
      "end": 42.336
    },
    {
      "line": 12,
      "text": "不看经验。",
      "start": 42.336,
      "speech_end": 43.526,
      "end": 43.676
    },
    {
      "line": 13,
      "text": "看的是把数字分清楚。",
      "start": 43.856,
      "speech_end": 46.535,
      "end": 46.685
    },
    {
      "line": 14,
      "text": "老大让本鲸把歌做成画面那天。",
      "start": 46.865,
      "speech_end": 50.734,
      "end": 50.884
    },
    {
      "line": 15,
      "text": "本鲸真的没算过账。",
      "start": 51.064,
      "speech_end": 53.445,
      "end": 53.595
    },
    {
      "line": 16,
      "text": "那天少了鞋要补，",
      "start": 53.775,
      "speech_end": 55.858,
      "end": 56.008
    },
    {
      "line": 16,
      "text": "手对不上要改。",
      "start": 56.008,
      "speech_end": 57.794,
      "end": 57.944
    },
    {
      "line": 17,
      "text": "还有一张给本鲸画出了多余的腿。",
      "start": 58.124,
      "speech_end": 62.291,
      "end": 62.441
    },
    {
      "line": 18,
      "text": "只能先放一边。",
      "start": 62.621,
      "speech_end": 64.407,
      "end": 64.557
    },
    {
      "line": 19,
      "text": "补图和重试一直记到了第三十七批。",
      "start": 64.737,
      "speech_end": 69.201,
      "end": 69.351
    },
    {
      "line": 20,
      "text": "生成图和补画加起来是一百八十五张。",
      "start": 69.531,
      "speech_end": 74.293,
      "end": 74.443
    },
    {
      "line": 21,
      "text": "七位伙伴都有了新姿势。",
      "start": 74.623,
      "speech_end": 77.599,
      "end": 77.749
    },
    {
      "line": 22,
      "text": "可这顿饭多少钱？",
      "start": 77.929,
      "speech_end": 80.012,
      "end": 80.162
    },
    {
      "line": 22,
      "text": "谁也没告诉本鲸。",
      "start": 80.162,
      "speech_end": 82.245,
      "end": 82.395
    },
    {
      "line": 23,
      "text": "龙娘把小的那只沙漏倒过来。",
      "start": 82.575,
      "speech_end": 86.146,
      "end": 86.296
    },
    {
      "line": 24,
      "text": "说它管的是几小时里的用量。",
      "start": 86.476,
      "speech_end": 90.047,
      "end": 90.197
    },
    {
      "line": 25,
      "text": "大的那只翻得慢，",
      "start": 90.377,
      "speech_end": 92.46,
      "end": 92.61
    },
    {
      "line": 25,
      "text": "管的是整整一周。",
      "start": 92.61,
      "speech_end": 94.693,
      "end": 94.843
    },
    {
      "line": 26,
      "text": "两只都有余量才敢接活。",
      "start": 95.023,
      "speech_end": 97.999,
      "end": 98.149
    },
    {
      "line": 27,
      "text": "空一只就得坐着等。",
      "start": 98.329,
      "speech_end": 100.71,
      "end": 100.86
    },
    {
      "line": 28,
      "text": "本鲸问她，",
      "start": 101.04,
      "speech_end": 102.23,
      "end": 102.38
    },
    {
      "line": 28,
      "text": "这沙漏到底值多少钱。",
      "start": 102.38,
      "speech_end": 105.059,
      "end": 105.209
    },
    {
      "line": 29,
      "text": "她呀，",
      "start": 105.389,
      "speech_end": 106.189,
      "end": 106.339
    },
    {
      "line": 29,
      "text": "摇头摇得很干脆。",
      "start": 106.339,
      "speech_end": 108.422,
      "end": 108.572
    },
    {
      "line": 30,
      "text": "说翻过去的是额度，",
      "start": 108.752,
      "speech_end": 111.133,
      "end": 111.283
    },
    {
      "line": 30,
      "text": "不是价目表。",
      "start": 111.283,
      "speech_end": 112.771,
      "end": 112.921
    },
    {
      "line": 31,
      "text": "也不是谁把朋友忘了。",
      "start": 113.101,
      "speech_end": 115.78,
      "end": 115.93
    },
    {
      "line": 32,
      "text": "本鲸这才想通，",
      "start": 116.11,
      "speech_end": 117.896,
      "end": 118.046
    },
    {
      "line": 32,
      "text": "饭碗倒是标着价。",
      "start": 118.046,
      "speech_end": 120.129,
      "end": 120.279
    },
    {
      "line": 33,
      "text": "工作日上午九点到十二点，",
      "start": 120.459,
      "speech_end": 123.733,
      "end": 123.883
    },
    {
      "line": 33,
      "text": "饭最贵。",
      "start": 123.883,
      "speech_end": 124.776,
      "end": 124.926
    },
    {
      "line": 34,
      "text": "下午两点到六点也一样贵。",
      "start": 125.106,
      "speech_end": 128.38,
      "end": 128.53
    },
    {
      "line": 35,
      "text": "中午那两个小时便宜一半。",
      "start": 128.71,
      "speech_end": 131.984,
      "end": 132.134
    },
    {
      "line": 36,
      "text": "本鲸不怕等嘛，",
      "start": 132.314,
      "speech_end": 134.1,
      "end": 134.25
    },
    {
      "line": 36,
      "text": "就挑这时候多干活。",
      "start": 134.25,
      "speech_end": 136.631,
      "end": 136.781
    },
    {
      "line": 37,
      "text": "可图片张数再多，",
      "start": 136.961,
      "speech_end": 139.044,
      "end": 139.194
    },
    {
      "line": 37,
      "text": "也换不出一个价钱。",
      "start": 139.194,
      "speech_end": 141.575,
      "end": 141.725
    },
    {
      "line": 38,
      "text": "本鲸没有摸鱼，",
      "start": 141.905,
      "speech_end": 143.691,
      "end": 143.841
    },
    {
      "line": 38,
      "text": "只是一直在等便宜的时候。",
      "start": 143.841,
      "speech_end": 147.115,
      "end": 147.265
    },
    {
      "line": 39,
      "text": "这米饭嘛，",
      "start": 147.445,
      "speech_end": 148.635,
      "end": 148.785
    },
    {
      "line": 39,
      "text": "是老大买的。",
      "start": 148.785,
      "speech_end": 150.273,
      "end": 150.423
    },
    {
      "line": 40,
      "text": "账单也只能由老大给。",
      "start": 150.603,
      "speech_end": 153.282,
      "end": 153.432
    },
    {
      "line": 41,
      "text": "本鲸记得清楚的呢，",
      "start": 153.612,
      "speech_end": 155.993,
      "end": 156.143
    },
    {
      "line": 41,
      "text": "是批次和返工。",
      "start": 156.143,
      "speech_end": 157.929,
      "end": 158.079
    },
    {
      "line": 42,
      "text": "还有谁站不稳，",
      "start": 158.259,
      "speech_end": 160.045,
      "end": 160.195
    },
    {
      "line": 42,
      "text": "这些都记在纸上。",
      "start": 160.195,
      "speech_end": 162.278,
      "end": 162.428
    },
    {
      "line": 43,
      "text": "先把伞撑稳。",
      "start": 162.608,
      "speech_end": 164.096,
      "end": 164.246
    },
    {
      "line": 44,
      "text": "下一集，",
      "start": 164.426,
      "speech_end": 165.319,
      "end": 165.469
    },
    {
      "line": 44,
      "text": "本鲸要让她们自己走两步。",
      "start": 165.469,
      "speech_end": 168.743,
      "end": 168.893
    }
  ]
}
